@page "/settings"
@inject RPGWeb.Services.GameSessionService Session
@inject NavigationManager Nav

<div class="settings-page">
    <div class="settings-header">
        <div>
            <h1>⚙️ Settings</h1>
            <p class="settings-subtitle">Configure your LLM backend</p>
        </div>
        <button class="btn-back" @onclick='() => Nav.NavigateTo("/")'>← Back to Menu</button>
    </div>

    <div class="settings-container">

        <!-- ── Backend ─────────────────────────────────────────────── -->
        <div class="settings-card">
            <h2>LLM Backend</h2>

            <div class="setting-row">
                <label>Backend</label>
                <div class="setting-control">
                    <select @bind="backend" @bind:after="BackendChanged">
                        <option value="ollama">Ollama</option>
                        <option value="llamacpp">llama.cpp</option>
                        <option value="gemini">Google Gemini</option>
                        <option value="openrouter">OpenRouter</option>
                    </select>
                </div>
            </div>

            <div class="setting-row">
                <label>Endpoint</label>
                <div class="setting-control">
                    <code>Managed by the server</code>
                    <small>Provider URLs can only be changed through trusted server configuration.</small>
                </div>
            </div>

            @if (backend == "gemini")
            {
                <div class="setting-row">
                    <label>API Key</label>
                    <div class="setting-control">
                        <code>GEMINI_API_KEY</code>
                        <small>Set this environment variable on the server. Credentials are never accepted or exposed by the web UI.</small>
                    </div>
                </div>
            }
            else if (backend == "openrouter")
            {
                <div class="setting-row">
                    <label>API Key</label>
                    <div class="setting-control">
                        <code>OPENROUTER_API_KEY</code>
                        <small>Set this environment variable on the server. Credentials are never accepted or exposed by the web UI.</small>
                    </div>
                </div>
            }
            <div class="setting-row">
                <label>Model</label>
                <div class="setting-control">
                    <div class="model-input-row">
                        <input type="text" @bind="model" placeholder="granite4:3b" class="model-input" />
                        @if (backend != "llamacpp")
                        {
                            <button class="btn-fetch" @onclick="FetchModelsAsync" disabled="@fetchingModels" title="Fetch available models from this provider">
                                @(fetchingModels ? "⏳" : "🔍 Fetch")
                            </button>
                        }
                    </div>
                    <small>Model identifier used for all LLM calls</small>
                    @if (availableModels.Count > 0)
                    {
                        <div class="model-pills">
                            @foreach (var m in availableModels)
                            {
                                <button class="model-pill @(m == model ? "active" : "")" @onclick="() => model = m">@m</button>
                            }
                        </div>
                    }
                    else if (fetchError != null)
                    {
                        <span class="fetch-error">@fetchError</span>
                    }
                </div>
            </div>

            @if (backend is "ollama" or "llamacpp")
            {
                <div class="setting-row">
                    <label>Context Size</label>
                    <div class="setting-control">
                        <div class="context-row">
                            <input type="range" min="1024" max="131072" step="1024"
                                   @bind="contextSize" @bind:event="oninput" class="context-slider" />
                            <span class="context-value">@contextSize.ToString("N0")</span>
                        </div>
                        <small>Token context window (affects memory usage and response quality)</small>
                    </div>
                </div>
            }
        </div>

        <!-- ── Connection Status ───────────────────────────────────── -->
        @if (statusMessage != null)
        {
            <div class="settings-card status-card @(statusOk ? "status-ok-card" : "status-error-card")">
                <span>@statusMessage</span>
            </div>
        }

        <!-- ── Actions ─────────────────────────────────────────────── -->
        <div class="settings-card actions-card">
            <button class="btn-action btn-test" @onclick="TestConnectionAsync" disabled="@busy">
                @(testing ? "Testing…" : "🔌 Test Connection")
            </button>
            <button class="btn-action btn-save" @onclick="ApplyAsync" disabled="@busy">
                @(saving ? "Applying…" : "Apply to This Session")
            </button>
            <button class="btn-action btn-reset" @onclick="ResetToDefaults" disabled="@busy">
                ↩ Reset Defaults
            </button>
        </div>

        @if (saved)
        {
            <p class="save-note">✅ Settings applied to this browser session. They will be used for your next game.</p>
        }
    </div>
</div>

@code {
    // Local copies of settings (edited without touching the live singleton)
    private string backend     = "ollama";
    private string model       = "granite4:3b";
    private int    contextSize = 8192;

    private List<string> availableModels = new();
    private string?      fetchError;
    private bool         fetchingModels;

    private string? statusMessage;
    private bool    statusOk;
    private bool    testing;
    private bool    saving;
    private bool    saved;

    private bool busy => testing || saving || fetchingModels;

    protected override void OnInitialized()
    {
        var s = Session.GetSettings();
        backend     = s.IsLlamaCpp ? "llamacpp" : s.IsGemini ? "gemini" : s.IsOpenRouter ? "openrouter" : "ollama";
        model       = s.ActiveModel;
        contextSize = s.ContextSize;
    }

    private async Task FetchModelsAsync()
    {
        fetchingModels = true;
        fetchError     = null;
        availableModels.Clear();
        try
        {
            // Use the selected provider/model with only the provider endpoints
            // that were loaded from trusted server configuration.
            var tmp = BuildTempSettings();
            var client = tmp.CreateClient();
            availableModels = await client.ListModelsAsync();
            if (availableModels.Count == 0)
                fetchError = "No models were returned by this provider.";
        }
        catch (Exception ex)
        {
            fetchError = $"Error: {ex.Message}";
        }
        finally
        {
            fetchingModels = false;
        }
    }

    private void BackendChanged()
    {
        var s = Session.GetSettings();
        model = backend switch
        {
            "gemini" => s.GeminiModel,
            "openrouter" => s.OpenRouterModel,
            _ => s.Model
        };
        availableModels.Clear();
        fetchError = null;
        statusMessage = null;
        saved = false;
    }

    private async Task TestConnectionAsync()
    {
        testing       = true;
        statusMessage = null;
        try
        {
            var tmp = BuildTempSettings();
            var client  = tmp.CreateClient();
            var healthy = await client.IsHealthyAsync();
            statusOk      = healthy;
            statusMessage = healthy
                ? $"✅ Connected to {client.BackendName}"
                : $"❌ Cannot reach {client.BackendName}";
        }
        catch (Exception ex)
        {
            statusOk      = false;
            statusMessage = $"❌ Error: {ex.Message}";
        }
        finally
        {
            testing = false;
        }
    }

    private async Task ApplyAsync()
    {
        saving = true;
        saved  = false;
        try
        {
            var s = Session.GetSettings();
            s.Backend     = backend;
            if (backend == "gemini") s.GeminiModel = model;
            else if (backend == "openrouter") s.OpenRouterModel = model;
            else s.Model = model;
            s.ContextSize = contextSize;
            Session.ApplySettings();
            // Refresh health status on the home page
            await Session.CheckLlmHealthAsync();
            saved = true;
        }
        finally
        {
            saving = false;
        }
    }

    private void ResetToDefaults()
    {
        var defaults = new CSharpRPGBackend.LLM.LlmSettings();
        backend     = "ollama";
        model       = defaults.Model;
        contextSize = defaults.ContextSize;
        statusMessage = null;
        saved = false;
        availableModels.Clear();
        fetchError = null;
    }

    private CSharpRPGBackend.LLM.LlmSettings BuildTempSettings()
    {
        var trusted = Session.GetSettings();
        return new CSharpRPGBackend.LLM.LlmSettings
        {
            Backend = backend,
            OllamaUrl = trusted.OllamaUrl,
            LlamaCppUrl = trusted.LlamaCppUrl,
            GeminiUrl = trusted.GeminiUrl,
            GeminiModel = model,
            GeminiApiKey = trusted.GeminiApiKey,
            OpenRouterUrl = trusted.OpenRouterUrl,
            OpenRouterModel = model,
            OpenRouterApiKey = trusted.OpenRouterApiKey,
            OpenRouterAppUrl = trusted.OpenRouterAppUrl,
            OpenRouterAppName = trusted.OpenRouterAppName,
            Model = model,
            ContextSize = contextSize
        };
    }
}
